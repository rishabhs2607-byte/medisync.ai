// Firestore security rules for MediSync AI
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == role;
    }

    function isApproved() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().status == 'approved';
    }

    function isAdmin() { return hasRole('admin'); }
    function isDoctor() { return hasRole('doctor'); }
    function isHospital() { return hasRole('hospital'); }
    function isPatient() { return hasRole('patient'); }

    function isApprovedDoctor() { return isDoctor() && isApproved(); }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function isActivePatient(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Doctor Applications
    match /doctorApplications/{applicationId} {
      allow read, create: if isAuthenticated() && (request.auth.uid == applicationId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Patient Clinical Records (active‑patient enforced)
    match /patients/{patientId} {
      allow read, write: if (isOwner(patientId) && isActivePatient(patientId)) ||
                         (isApproved() && (isApprovedDoctor() || isHospital() || isAdmin()) && isActivePatient(patientId));

      // Live vitals subcollection
      match /liveVitals/{vitalId} {
        // Patient can write their own vitals
        allow write: if isOwner(patientId);
        // Doctor/Hospital/Admin can read vitals
        allow read: if isDoctor() || isHospital() || isAdmin() || (isAuthenticated() && request.auth.uid == patientId);
      }
    }

    // Hospital Profiles
    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated() && (isOwner(hospitalId) || isAdmin() || isApprovedDoctor());
      allow create: if isAuthenticated() && request.auth.uid == hospitalId;
      allow update: if isOwner(hospitalId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId ||
        (isApproved() && (isHospital() || isAdmin()))
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        (isApproved() && (isApprovedDoctor() || isHospital() || isAdmin()))
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId ||
        (isApproved() && (isHospital() || isAdmin()))
      );
      allow delete: if isAdmin() || (isApproved() && isHospital());
    }

    // Prescriptions
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        (isApproved() && (isApprovedDoctor() || isHospital() || isAdmin()))
      );
      allow create, update: if isAuthenticated() && (
        (isApprovedDoctor() && request.resource.data.doctorId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Emergency Alerts
    match /alerts/{alertId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        (isApproved() && (isApprovedDoctor() || isHospital() || isAdmin()))
      );
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Consultation Sessions
    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId ||
        isAdmin()
      );
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.patientId == request.auth.uid ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.doctorId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // WebRTC Rooms (signalling & chat)
    match /rooms/{roomId} {
      allow read, create: if isAuthenticated();
      allow update: if request.auth.uid == resource.data.patientId || request.auth.uid == resource.data.doctorId || isAdmin();
      match /callerCandidates/{id} { allow read, write: if isAuthenticated(); }
      match /calleeCandidates/{id} { allow read, write: if isAuthenticated(); }
      match /messages/{id} { allow read, write: if isAuthenticated(); }
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // IoT Device Registry
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        (isApproved() && (isApprovedDoctor() || isHospital() || isAdmin()))
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId || isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
